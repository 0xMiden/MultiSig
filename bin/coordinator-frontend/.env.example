# Required: URL of a Guardian 0.18 instance on the same Miden network, e.g.
# https://guardian-testnet.openzeppelin.com (testnet) or
# https://guardian-devnet.openzeppelin.com (devnet).
NEXT_PUBLIC_GUARDIAN_ENDPOINT=
# Other Guardians users may switch to at runtime (header > Guardian), as full
# URLs separated by commas. The app can reach only these and the one above.
# NEXT_PUBLIC_GUARDIAN_ENDPOINTS=https://guardian-devnet.openzeppelin.com

# Miden network name: devnet, testnet, mainnet, local or custom. Sets the
# wallet network, the address prefix and the invitation-code rule.
NEXT_PUBLIC_MIDEN_NETWORK=testnet
# Full http(s) URLs on that network, the same one as Guardian. The app has no
# built-in endpoints and rejects shorthands such as `testnet`.
NEXT_PUBLIC_MIDEN_RPC_URL=https://rpc.testnet.miden.io
NEXT_PUBLIC_MIDEN_NOTE_TRANSPORT_URL=https://transport.miden.io

# Transaction prover. Unset (or `local`) proves in the browser: private, but
# slow enough that a transaction can expire before submission (the app then
# asks you to execute again). Opt in to a remote prover URL only if you accept
# that it sees each transaction's full inputs, including private note contents.
# NEXT_PUBLIC_MIDEN_PROVER_URL=https://tx-prover.testnet.miden.io

# Registration funds a newly created account (testnet: 1 USDCX, within a few
# minutes). Devnet requires this invitation code; testnet takes none (ignored there).
NEXT_PUBLIC_MIDEN_REGISTRATION_CODE=guardian

# Optional external signer integration.
NEXT_PUBLIC_PARA_API_KEY=
# Para environment matching the key: sandbox, beta (for beta_… keys), production,
# or development (Para's own local stack on localhost, not for deployments).
NEXT_PUBLIC_PARA_ENVIRONMENT=beta

# Optional assistant endpoint.
NEXT_PUBLIC_CHAT_ENDPOINT=

# Content-Security-Policy: the app may only connect to the Guardians above, the
# configured Miden RPC, note transport and prover, Para and the chat endpoint.
# List any other origin it must reach, separated by spaces or commas.
NEXT_PUBLIC_CSP_CONNECT_SRC=

# Debugging: log Miden SDK calls to the browser console (account IDs, note IDs,
# balances). Off unless set to 1.
# NEXT_PUBLIC_MIDEN_DIAGNOSTICS=1

# Direct USB Ledger needs no additional environment variables or Ledger credentials.
