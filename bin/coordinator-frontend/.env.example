# Required: URL of a Guardian v0.18.0-rc.2 instance configured for Miden devnet.
NEXT_PUBLIC_GUARDIAN_ENDPOINT=

# Miden SDK endpoint shorthands. Keep both on the same network as Guardian.
NEXT_PUBLIC_MIDEN_RPC_URL=devnet
# Network identity (devnet, testnet, mainnet, local, custom); inferred from the RPC when unset.
# NEXT_PUBLIC_MIDEN_NETWORK=devnet
NEXT_PUBLIC_MIDEN_NOTE_TRANSPORT_URL=devnet

# Transaction prover. Unset (or `local`) proves in the browser: private, but
# slow enough that a transaction can expire before submission (the app then
# asks you to execute again). Opt in to a remote prover (`devnet`, `testnet` or
# a prover URL) only if you accept that it sees each transaction's full inputs,
# including private note contents.
# NEXT_PUBLIC_MIDEN_PROVER_URL=devnet

# Devnet invitation code used to register and fund a newly created account.
NEXT_PUBLIC_MIDEN_REGISTRATION_CODE=guardian

# Optional external signer integration.
NEXT_PUBLIC_PARA_API_KEY=
NEXT_PUBLIC_PARA_ENVIRONMENT=development

# Optional assistant endpoint.
NEXT_PUBLIC_CHAT_ENDPOINT=

# Content-Security-Policy: the app may only connect to the configured Guardian,
# Miden (*.miden.io), OpenZeppelin Guardians (*.openzeppelin.com), Para and the
# chat endpoint. List any other origin it must reach (e.g. a self-hosted
# Guardian entered at runtime), separated by spaces or commas.
NEXT_PUBLIC_CSP_CONNECT_SRC=

# Debugging: log Miden SDK calls to the browser console (account IDs, note IDs,
# balances). Off unless set to 1.
# NEXT_PUBLIC_MIDEN_DIAGNOSTICS=1

# Direct USB Ledger needs no additional environment variables or Ledger credentials.
